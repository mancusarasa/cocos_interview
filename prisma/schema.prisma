// Mirrors database.sql (including its improvements over the provided baseline). Postgres lowercases unquoted identifiers, so the real
// column names are e.g. `instrumentid` / `previousclose`; fields are camelCase
// in the client and mapped to the actual columns with @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique @db.VarChar(255)
  accountNumber String  @unique @map("accountnumber") @db.VarChar(20)

  orders Order[]

  @@map("users")
}

model Instrument {
  id     Int     @id @default(autoincrement())
  ticker String @unique @db.VarChar(10)
  name   String @db.VarChar(255)
  type   String @db.VarChar(10)

  orders     Order[]
  marketData MarketData[]

  @@map("instruments")
}

model Order {
  id           Int       @id @default(autoincrement())
  instrumentId Int       @map("instrumentid")
  userId       Int       @map("userid")
  size         Int
  price        Decimal?  @db.Decimal(10, 2)
  type         String    @db.VarChar(10)
  side         String    @db.VarChar(10)
  status       String    @db.VarChar(20)
  datetime     DateTime  @db.Timestamp(6)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status], map: "idx_orders_user_status")
  @@map("orders")
}

model MarketData {
  id            Int       @id @default(autoincrement())
  instrumentId  Int       @map("instrumentid")
  high          Decimal?  @db.Decimal(10, 2)
  low           Decimal?  @db.Decimal(10, 2)
  open          Decimal?  @db.Decimal(10, 2)
  close         Decimal   @db.Decimal(10, 2)
  previousClose Decimal   @map("previousclose") @db.Decimal(10, 2)
  date          DateTime  @db.Date

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([instrumentId, date], map: "uq_marketdata_instrument_date")

  @@map("marketdata")
}
