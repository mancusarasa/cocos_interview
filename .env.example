PORT=3000

# Postgres connection string. The app only reads DATABASE_URL (used by Prisma).
# If the provider requires SSL, append ?sslmode=require to the URL.
# Remote (what the final solution must use):
DATABASE_URL=postgres://user:password@remote-host:5432/dbname
# Local dockerized Postgres (run `make up-local`):
# DATABASE_URL=postgres://postgres:postgres@db:5432/cocos

# Set to true if the remote provider requires SSL
DATABASE_SSL=false

# Only used by the optional local `db` service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cocos
